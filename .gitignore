# Claude Code local settings
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]

# Lambda build artifacts (installed from lambda/requirements.txt at build/deploy time)
lambda/venv/
lambda/certifi/
lambda/certifi-*.dist-info/
lambda/charset_normalizer/
lambda/charset_normalizer-*.dist-info/
lambda/idna/
lambda/idna-*.dist-info/
lambda/requests/
lambda/requests-*.dist-info/
lambda/urllib3/
lambda/urllib3-*.dist-info/
lambda/*.so
*.zip

# Fase 4.2 agent backend build artifacts (installed from
# agent/backend/requirements.txt via pip install --target)
agent/backend/*
!agent/backend/ask_agent.py
!agent/backend/nyctaxi_assistant.py
!agent/backend/requirements.txt

# Fase 4.2 agent web (Vite/React)
agent/web/node_modules/
agent/web/dist/
agent/web/.env

# Terraform
/terraform.tfstate
/terraform.tfstate.backup
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
!terraform/*.tfvars.example
crash.log
crash.*.log
